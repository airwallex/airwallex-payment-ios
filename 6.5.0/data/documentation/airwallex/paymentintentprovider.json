ice","code":"createPaymentIntent()"},{"type":"text","text":" asynchronously when needed. The provider"},{"type":"text","text":" "},{"type":"text","text":"must also supply the basic payment information (amount, currency, customerId) synchronously."}],"type":"paragraph"},{"text":"Usage Example","level":2,"type":"heading","anchor":"Usage-Example"},{"code":["class MyPaymentIntentProvider: NSObject, PaymentIntentProvider {","    let amount: NSDecimalNumber = NSDecimalNumber(string: \"99.99\")","    let currency: String = \"USD\"","    let customerId: String? = \"customer_123\"","","    func createPaymentIntent() async throws -> AWXPaymentIntent {","        \/\/ Call your backend to create the payment intent","        let response = try await MyBackendAPI.createPaymentIntent(","            amount: amount.decimalValue,","            currency: currency,","            customerId: customerId","        )","        return response.paymentIntent","    }","}","","\/\/ Use with Session","let provider = MyPaymentIntentProvider()","let session = Session(","    paymentIntentProvider: provider,","    countryCode: \"US\",","    returnURL: \"myapp:\/\/payment\/return\"",")"],"syntax":"swift","type":"codeListing"},{"text":"Important Notes","level":2,"type":"heading","anchor":"Important-Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"currency","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"customerId","type":"codeVoice"},{"text":" properties must return values immediately (they cannot be async)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The values returned by "},{"type":"codeVoice","code":"amount"},{"type":"text","text":", "},{"type":"codeVoice","code":"currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"customerId"},{"type":"text","text":" must match the values"},{"type":"text","text":" "},{"type":"text","t