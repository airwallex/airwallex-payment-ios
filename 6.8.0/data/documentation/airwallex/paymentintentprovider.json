lowing you to defer"},{"type":"text","text":" "},{"type":"text","text":"the creation of a payment intent until just before payment confirmation or when it is required."}],"type":"paragraph"},{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"When using "},{"code":"Session","type":"codeVoice"},{"type":"text","text":" with a payment intent provider instead of a pre-created intent,"},{"type":"text","text":" "},{"type":"text","text":"the SDK will call "},{"code":"createPaymentIntent()","type":"codeVoice"},{"type":"text","text":" asynchronously when needed. The provider"},{"type":"text","text":" "},{"type":"text","text":"must also supply the basic payment information (amount, currency, customerId) synchronously."}],"type":"paragraph"},{"level":2,"text":"Usage Example","type":"heading","anchor":"Usage-Example"},{"code":["class MyPaymentIntentProvider: NSObject, PaymentIntentProvider {","    let amount: NSDecimalNumber = NSDecimalNumber(string: \"99.99\")","    let currency: String = \"USD\"","    let customerId: String? = \"customer_123\"","","    func createPaymentIntent() async throws -> AWXPaymentIntent {","        \/\/ Call your backend to create the payment intent","        let response = try await MyBackendAPI.createPaymentIntent(","            amount: amount.decimalValue,","            currency: currency,","            customerId: customerId","        )","        return response.paymentIntent","    }","}","","\/\/ Use with Session","let provider = MyPaymentIntentProvider()","let session = Session(","    paymentIntentProvider: provider,","    countryCode: \"US\",","    returnURL: \"myapp:\/\/payment\/return\"",")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Important Notes","type":"heading","anchor":"Important-Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"currency","type":