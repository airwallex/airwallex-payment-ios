{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airwallex\/paymentintentprovider"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/airwallex\/paymentintentprovider"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@objc","kind":"attribute"},{"text":" ","kind":"text"},{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaymentIntentProvider","kind":"identifier"}],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"code":"PaymentIntentProvider","type":"codeVoice"},{"type":"text","text":" enables delayed payment intent creation, allowing you to defer"},{"type":"text","text":" "},{"type":"text","text":"the creation of a payment intent until just before payment confirmation or when it is required."}]},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When using ","type":"text"},{"code":"Session","type":"codeVoice"},{"text":" with a payment intent provider instead of a pre-created intent,","type":"text"},{"text":" ","type":"text"},{"text":"the SDK will call ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"},{"text":" asynchronously when needed. The provider","type":"text"},{"text":" ","type":"text"},{"text":"must also supply the basic payment information (amount, currency, customerId) synchronously.","type":"text"}]},{"type":"heading","level":2,"text":"Usage Example","anchor":"Usage-Example"},{"type":"codeListing","syntax":"swift","code":["class MyPaymentIntentProvider: NSObject, PaymentIntentProvider {","    let amount: NSDecimalNumber = NSDecimalNumber(string: \"99.99\")","    let currency: String = \"USD\"","    let customerId: String? = \"customer_123\"","","    func createPaymentIntent() async throws -> AWXPaymentIntent {","        \/\/ Call your backend to create the payment intent","        let response = try await MyBackendAPI.createPaymentIntent(","            amount: amount.decimalValue,","            currency: currency,","            customerId: customerId","        )","        return response.paymentIntent","    }","}","","\/\/ Use with Session","let provider = MyPaymentIntentProvider()","let session = Session(","    paymentIntentProvider: provider,","    countryCode: \"US\",","    returnURL: \"myapp:\/\/payment\/return\"",")"]},{"type":"heading","level":2,"text":"Important Notes","anchor":"Important-Notes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"amount"},{"type":"text","text":", "},{"type":"codeVoice","code":"currency"},{"type":"text","text":" and "},{"type":"codeVoice","code":"customerId"},{"type":"text","text":" properties must return values immediately (they cannot be async)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The values returned by ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"currency","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"customerId","type":"codeVoice"},{"text":" must match the values","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"code":"AWXPaymentIntent","type":"codeVoice"},{"text":" returned by ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":" should be zero for recurring-only payments (no immediate charge)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"createPaymentIntent()"},{"type":"text","text":" method will only be called once, and the result is cached"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"},{"text":" throws an error, the payment flow will fail","type":"text"}]}]}]},{"type":"aside","style":"note","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"Session","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AWXPaymentIntent","type":"codeVoice"}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex"]]},"metadata":{"roleHeading":"Protocol","modules":[{"name":"Airwallex"}],"navigatorTitle":[{"text":"PaymentIntentProvider","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaymentIntentProvider"}],"externalID":"c:@M@Airwallex@objc(pl)PaymentIntentProvider","symbolKind":"protocol","title":"PaymentIntentProvider","role":"symbol"},"topicSections":[{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider\/amount","doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider\/currency","doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider\/customerId"]},{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider\/createPaymentIntent()"]}],"abstract":[{"text":"A protocol for providing payment intents on-demand during the payment flow.","type":"text"}],"sections":[],"references":{"doc://org.cocoapods.Airwallex/documentation/Airwallex":{"abstract":[],"role":"collection","url":"\/documentation\/airwallex","identifier":"doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex","kind":"symbol","ty