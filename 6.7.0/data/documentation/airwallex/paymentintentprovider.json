"anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"When using ","type":"text"},{"type":"codeVoice","code":"Session"},{"text":" with a payment intent provider instead of a pre-created intent,","type":"text"},{"text":" ","type":"text"},{"text":"the SDK will call ","type":"text"},{"type":"codeVoice","code":"createPaymentIntent()"},{"text":" asynchronously when needed. The provider","type":"text"},{"text":" ","type":"text"},{"text":"must also supply the basic payment information (amount, currency, customerId) synchronously.","type":"text"}],"type":"paragraph"},{"text":"Usage Example","anchor":"Usage-Example","level":2,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["class MyPaymentIntentProvider: NSObject, PaymentIntentProvider {","    let amount: NSDecimalNumber = NSDecimalNumber(string: \"99.99\")","    let currency: String = \"USD\"","    let customerId: String? = \"customer_123\"","","    func createPaymentIntent() async throws -> AWXPaymentIntent {","        \/\/ Call your backend to create the payment intent","        let response = try await MyBackendAPI.createPaymentIntent(","            amount: amount.decimalValue,","            currency: currency,","            customerId: customerId","        )","        return response.paymentIntent","    }","}","","\/\/ Use with Session","let provider = MyPaymentIntentProvider()","let session = Session(","    paymentIntentProvider: provider,","    countryCode: \"US\",","    returnURL: \"myapp:\/\/payment\/return\"",")"]},{"text":"Important Notes","anchor":"Important-Notes","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"amount"},{"text":", ","type":"text"},{"type":"codeVoice","code":"currency"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"customerId"},{"text":" properties must return values immediately (they cannot be async)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The values returned by ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":", ","type":"text"},{"code":"currency","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"customerId","type":"codeVoice"},{"text":" must match the values","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"code":"AWXPaymentIntent","type":"codeVoice"},{"text":" returned by ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"amount","type":"codeVoice"},{"text":" should be zero for recurring-only payments (no immediate charge)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"createPaymentIntent()"},{"type":"text","text":" method will only be called once, and the result is cached"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"code":"createPaymentIntent()","type":"codeVoice"},{"type":"text","text":" throws an error, the payment flow will fail"}]}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"Session","type":"codeVoice"},{"type":"text","text":", "},{"code":"AWXPaymentIntent","type":"codeVoice"}],"type":"paragraph"}],"type":"aside","name":"See Also"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/airwallex\/paymentintentprovider"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/airwallex\/paymentintentprovider"]}],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://org.cocoapods.Airwallex/documentation/Airwallex/PaymentIntentProvider/currency":{"url":"\/documentation\/airwallex\/paymentintentprovider\/currency","required":true,"fragments":[{"text":"var","kind":"keyword"},{